# ClientReady configuration. Copy to .env.local and fill in.
# All keys are server-side only; none are ever sent to the browser.

# ── Gnani speech (required for real voice) ─────────────────────────────
# Create a key at https://app.gnani.ai/voice (sign in with your registered email).
GNANI_API_KEY=
# GNANI_BASE_URL=https://api.vachana.ai
# Timbre model: timbre-v2.5 (default, challenge model) or timbre-v3.0
# GNANI_TTS_MODEL=timbre-v2.5
# Voice for the spoken English debrief (default Trupti on v2.5, Kalpana on v3.0)
# GNANI_COACH_VOICE=Trupti
# GNANI_STT_TIMEOUT_MS=30000
# GNANI_TTS_TIMEOUT_MS=30000

# ── Reasoning (client role-play + coaching) ────────────────────────────
# Chosen automatically: anthropic if ANTHROPIC_API_KEY is set, else gemini if
# GEMINI_API_KEY is set, else openai-compatible if OPENAI_COMPAT_* is set,
# else the labelled demo engine.
# REASONING_PROVIDER=anthropic | gemini | openai-compatible | demo

# Option A: Google Gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# GEMINI_CLIENT_MODEL=gemini-3.8-flash      # client role-play (try gemini-3.5-flash-lite for lower latency)
# GEMINI_COACH_MODEL=gemini-3.8-flash       # coaching report
# GEMINI_CLIENT_THINKING_LEVEL=LOW          # default LOW (~3.6 s vs ~12 s per turn on 3.8-flash); "none" to disable
# GEMINI_COACH_THINKING_LEVEL=              # default: model's own setting (best report quality)

# Option B: Anthropic Claude
ANTHROPIC_API_KEY=
# ANTHROPIC_CLIENT_MODEL=claude-opus-5-5
# ANTHROPIC_COACH_MODEL=claude-opus-5-5

# Option C: any OpenAI-compatible /chat/completions server, e.g. Gnani Evon v3.3
# open weights served with vLLM:
#   vllm serve gnani/gnani-evon-v3.3-30B-A3B --port 8000
# OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
# OPENAI_COMPAT_MODEL=gnani/gnani-evon-v3.3-30B-A3B
# OPENAI_COMPAT_API_KEY=
# Label shown in the UI. Only call it Evon if it really is Evon.
# OPENAI_COMPAT_LABEL=Gnani Evon v3.3 (self-hosted)

# ── Abuse protection ───────────────────────────────────────────────────
# Requests per minute per IP, per endpoint (in-memory, per instance)
# RATE_LIMIT_PER_MINUTE=30

# ── Credit protection for the public demo ──────────────────────────────
# Durable counters shared by all Vercel instances (https://upstash.com, free tier is enough).
# Without these, limits fall back to per-instance memory and a warning is logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Live calls per visitor per day (visitor = salted SHA-256 of the IP; raw IPs are never stored)
# LIVE_SESSIONS_PER_VISITOR_PER_DAY=3
# Live calls per day across everyone. Days roll over at midnight IST.
# LIVE_SESSIONS_PER_DAY=60
# Kill switch: set to "off" to pause all live calls (the sample call keeps working)
# LIVE_MODE=on
# Secret salt for hashing visitor IPs. Use a long random string.
VISITOR_HASH_SALT=
# Token for GET /api/usage (send it as the x-admin-token header)
ADMIN_TOKEN=
